# App runtime (use Supabase Transaction pooler / port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (use Direct connection / port 5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Local Postgres alternative:
# DATABASE_URL="postgresql://davidgreenland@localhost:5432/vis_lab_tracker"
# DIRECT_URL="postgresql://davidgreenland@localhost:5432/vis_lab_tracker"

AUTH_SECRET="replace-with-a-long-random-string"
