# Neon (recommended) — Dashboard → Connect
# Pooled connection (host contains -pooler) → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (same host without -pooler) → DIRECT_URL
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Local Postgres alternative:
# DATABASE_URL="postgresql://davidgreenland@localhost:5432/vis_lab_tracker"
# DIRECT_URL="postgresql://davidgreenland@localhost:5432/vis_lab_tracker"

AUTH_SECRET="replace-with-a-long-random-string"

