# Neon (recommended) — Dashboard → Connect
# Pooled connection (host contains -pooler) → DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (same host without -pooler) → DIRECT_URL
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js / Google
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"
# Optional explicit URL (Vercel usually infers this)
# AUTH_URL="https://vis-lab-tracker.vercel.app"

# Comma-separated emails that become HOD automatically on first claim
# (use this once to bootstrap the first Head of Department)
HOD_BOOTSTRAP_EMAILS="you@school.edu,you@gmail.com"
